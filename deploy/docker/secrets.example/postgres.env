# 采集库（PostgreSQL）凭据模板 —— 复制到 secrets/postgres.env 后填真值。
#
#   cp secrets.example/postgres.env secrets/postgres.env
#   chmod 600 secrets/postgres.env
#   # 生成一个口令（不要手敲）：openssl rand -hex 24 写入 POSTGRES_PASSWORD
#
# 这个文件同时被两个容器读（compose 的 env_file）：
#   * db  ：官方镜像用它做 initdb（POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB）
#   * app ：入口脚本用它组装 DATABASE_URL=postgresql://<user>:<pw>@db:5432/miroflow_collection_v1
# 这**不是** compose 的插值来源（compose 不会把这里的内容插进 compose.yaml），
# 所以忘记传 --env-file 也不会拼出「空口令」的 DSN —— 最坏情况是采集面保持 503。
#
# 库名固定 miroflow_collection_v1（compose 里钉死），这里不需要写 POSTGRES_DB。
# 口令里可以出现 @ : / 等字符（组装时按 URL 规则转义）；仍建议用 hex 以免人工输入出错。

POSTGRES_USER=miroflow
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
