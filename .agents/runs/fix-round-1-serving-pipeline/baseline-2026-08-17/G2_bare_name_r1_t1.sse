event: answer
data: {"query":"国际先进技术应用推进中心（深圳）","query_type":"canonical_v2:A:answer","answer_text":"国际先进技术应用推进中心（深圳）位于河套深港科技创新合作区深圳园区。该中心与河套数学与交叉学科研究院于4月25日在河套深圳园区揭牌成立，旨在进一步提升该区域在基础研究和技术应用等关键环节的创新发展能力。","citations":[],"evidence":[],"clarification":null,"structured_payload":{},"answer_style":"llm_synthesized","citation_map":{},"suggested_followups":[]}

