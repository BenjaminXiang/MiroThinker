event: answer
data: {"query":"这个中心的企业培育情况怎么样","query_type":"canonical_v2:A:answer","answer_text":"河套深圳园区已集聚447家科技企业，汇聚超过200个高端科研项目、10个国家重大科研平台及1.5万余名科研人才。近期，河套数学与交叉学科研究院、国际先进技术应用推进中心（深圳）等机构在园区揭牌，进一步提升了园区在基础研究和技术应用方面的创新能力。","citations":[],"evidence":[],"clarification":null,"structured_payload":{},"answer_style":"llm_synthesized","citation_map":{},"suggested_followups":[]}

event: done
